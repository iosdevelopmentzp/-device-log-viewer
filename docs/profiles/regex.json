{
  "name": "Regular expression example",
  "framing": { "kind": "lines" },
  "entry": {
    "kind": "regex",
    "pattern": "^(?<time>\\d{2}:\\d{2}:\\d{2}) (?<level>[A-Z]+) (?<module>[A-Za-z0-9_.]+) - (?<message>.*)$"
  },
  "timestamp": { "format": "HH:mm:ss", "timeZone": "UTC" },
  "levels": [
    { "id": "debug", "codes": ["D", "DEBUG"], "title": "Debug", "style": "secondary" },
    { "id": "info", "codes": ["I", "INFO"], "title": "Info", "style": "blue" },
    { "id": "error", "codes": ["E", "ERROR"], "title": "Error", "style": "red", "alerts": true, "colorsMessage": true }
  ],
  "attributes": [
    { "id": "module", "title": "Module", "columnWidth": 120 }
  ]
}
